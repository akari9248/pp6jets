universe = vanilla
executable = fullsim.sh
getenv = True

Should_Transfer_Files = Yes
arguments = $(PART_NUM) $(Process)
Transfer_Input_Files = fullsim.sh, existing_PUfiles_RunIISummer20UL17.txt
Transfer_Output_Files = JME-RunIISummer20UL17MiniAODv2-$(Process).root
output_destination = root://eoscms.cern.ch//eos/cms/store/group/phys_smp/ec/zhye/pp6j_20GeV_MINIAOD_on/Part$(PART_NUM)

output = log/$(Cluster)_$(Process).out
error = log/$(Cluster)_$(Process).err
log = log/$(Cluster).log
MY.SingularityImage = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/cmssw/el7:x86_64"

x509userproxy = x509up
+JobFlavour = "tomorrow"
+RequestMemory = 10240
max_retries = 2
requirements = Machine =!= LastRemoteHost
queue $(QUEUE_NUM)
